      </version>
      <version name="1.0.1" author="tRoshan" time="2026-08-21T22:01:01Z">
        <changelog><![CDATA[+ Updated the install instructions: the opencv extra no longer exists in scenedetect 0.7, and the Windows installer needs no Python at all
+ Added a collapsed "Installing the scenedetect CLI" section with copy buttons for the download link and the pip command]]></changelog>
        <source file="Functions/SceneDetect.lua">https://github.com/thareeqroshan/ReaperStuff/raw/e7235052f79129b45ca32ca0d7884c795d983042/ReaScripts/Functions/SceneDetect.lua</source>
