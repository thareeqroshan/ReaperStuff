    <reapack name="tRoshan Video Scene Detect GUI.lua" type="script" desc="Video Scene Detect - detect scene cuts in the selected video item and create markers or regions">
      <version name="1.0.0" author="tRoshan" time="2026-08-05T13:55:52Z">
        <changelog><![CDATA[+ Initial Release
+ Requires ReaImGui and the PySceneDetect CLI on PATH (pip install "scenedetect[opencv]")
+ Choose markers or regions, detector, threshold, minimum scene length, name prefix and colour
+ Optionally clear existing scene markers/regions in range and scan only the time selection]]></changelog>
        <source file="Functions/SceneDetect.lua">https://github.com/thareeqroshan/ReaperStuff/raw/419f21dc966db3d4772f683988ad417d53641359/ReaScripts/Functions/SceneDetect.lua</source>
